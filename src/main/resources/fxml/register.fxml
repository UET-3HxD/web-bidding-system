<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../styles/login.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.RegisterController">
    <children>
        <VBox alignment="CENTER" spacing="15" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" styleClass="login-container">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            <children>
                <Label text="📝 ĐĂNG KÝ TÀI KHOẢN" styleClass="title" />

                <TextField fx:id="usernameField" promptText="Tên đăng nhập" styleClass="input-field" />

                <VBox spacing="5">
                    <PasswordField fx:id="passwordField" promptText="Mật khẩu" styleClass="input-field" />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ProgressBar fx:id="passwordStrengthBar" prefWidth="200" visible="false" managed="false" />
                        <Label fx:id="passwordStrengthLabel" text="" style="-fx-font-size: 12px;" visible="false" managed="false" />
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu" styleClass="input-field" />
                    <Label fx:id="confirmPasswordError" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" managed="false" />
                </VBox>

                <VBox spacing="5">
                    <TextField fx:id="emailField" promptText="Email" styleClass="input-field" />
                    <Label fx:id="emailError" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" managed="false" />
                </VBox>

                <Button fx:id="registerButton" text="ĐĂNG KÝ" onAction="#handleRegister" styleClass="login-button" />
                <Button fx:id="backButton" text="← Quay lại đăng nhập" onAction="#handleBack" styleClass="register-button" />

                <Label fx:id="messageLabel" styleClass="message-label" visible="false" managed="false" />
                <ProgressIndicator fx:id="loadingIndicator" styleClass="loading-indicator" visible="false" managed="false" />
            </children>
        </VBox>
    </children>
</AnchorPane>