<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.team3HxD.controller.RegisterController"
            stylesheets="@../styles/login.css"
            styleClass="login-root">

    <HBox AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <!-- LEFT PANEL -->
        <VBox prefWidth="420"
              styleClass="left-panel">

            <padding>
                <Insets top="45" right="45" bottom="45" left="45"/>
            </padding>

            <!-- Logo -->
            <HBox spacing="10">
                <Label text="⚖" styleClass="logo-icon"/>
                <Label text="3HxD" styleClass="logo-text"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Welcome -->
            <VBox spacing="22">

                <Label text="Create&#10;Account!"
                       wrapText="true"
                       styleClass="welcome-title"/>

                <Label text="Tạo tài khoản mới để tham gia hệ thống đấu giá trực tuyến hiện đại."
                       wrapText="true"
                       maxWidth="280"
                       styleClass="welcome-description"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

        </VBox>

        <!-- RIGHT PANEL -->
        <StackPane HBox.hgrow="ALWAYS"
                   styleClass="right-panel">

            <VBox alignment="CENTER"
                  spacing="22"
                  prefWidth="540"
                  maxWidth="540"
                  styleClass="login-card">

                <padding>
                    <Insets top="42" right="45" bottom="40" left="45"/>
                </padding>

                <!-- TITLE -->
                <VBox alignment="CENTER" spacing="8">

                    <Label text="ĐĂNG KÝ"
                           styleClass="login-title"/>

                    <Label text="TẠO TÀI KHOẢN MỚI"
                           styleClass="login-subtitle"/>
                </VBox>

                <!-- INPUTS -->
                <VBox spacing="16">

                    <TextField fx:id="usernameField"
                               promptText="Tên đăng nhập"
                               styleClass="modern-input"/>

                    <!-- PASSWORD -->
                    <VBox spacing="6">

                        <PasswordField fx:id="passwordField"
                                       promptText="Mật khẩu"
                                       styleClass="modern-input"/>

                        <HBox alignment="CENTER_LEFT"
                              spacing="10">

                            <ProgressBar fx:id="passwordStrengthBar"
                                         prefWidth="220"
                                         visible="false"
                                         managed="false"/>

                            <Label fx:id="passwordStrengthLabel"
                                   visible="false"
                                   managed="false"
                                   style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                        </HBox>
                    </VBox>

                    <!-- CONFIRM -->
                    <VBox spacing="6">

                        <PasswordField fx:id="confirmPasswordField"
                                       promptText="Xác nhận mật khẩu"
                                       styleClass="modern-input"/>

                        <Label fx:id="confirmPasswordError"
                               visible="false"
                               managed="false"
                               style="-fx-text-fill:#FF7A7A; -fx-font-size:12px;"/>
                    </VBox>

                    <!-- EMAIL -->
                    <VBox spacing="6">

                        <TextField fx:id="emailField"
                                   promptText="Email"
                                   styleClass="modern-input"/>

                        <Label fx:id="emailError"
                               visible="false"
                               managed="false"
                               style="-fx-text-fill:#FF7A7A; -fx-font-size:12px;"/>
                    </VBox>

                </VBox>

                <!-- REGISTER BUTTON -->
                <Button fx:id="registerButton"
                        text="TẠO TÀI KHOẢN   →"
                        onAction="#handleRegister"
                        maxWidth="Infinity"
                        styleClass="login-button"/>

                <!-- BACK -->
                <Button fx:id="backButton"
                        text="← Quay lại đăng nhập"
                        onAction="#handleBack"
                        maxWidth="Infinity"
                        styleClass="register-button"/>

                <!-- MESSAGE -->
                <StackPane>

                    <ProgressIndicator fx:id="loadingIndicator"
                                       visible="false"
                                       managed="false"
                                       maxHeight="26"/>

                    <Label fx:id="messageLabel"
                           visible="false"
                           managed="false"
                           styleClass="message-label"/>
                </StackPane>

            </VBox>

        </StackPane>

    </HBox>

</AnchorPane>