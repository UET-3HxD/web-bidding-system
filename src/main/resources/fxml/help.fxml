<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3hxd.controller.HelpController">

    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="30" left="10"/></padding>
                <Label text="⚖" styleClass="logo-icon"/>
                <Label text="3HxD" styleClass="logo-text"/>
            </HBox>
            <VBox spacing="5">
                <!-- USER -->
                <Button fx:id="btnAccount" text="👤   Tài khoản" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToAccount"/>
                <Button fx:id="btnAuction" text="⏹   Sàn đấu giá" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToAuction"/>
                <Button fx:id="btnMyBids" text="⏱   Bid đang tham gia" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToMyBids"/>
                <Button fx:id="btnProducts" text="📦   Sản phẩm của bạn" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToProducts"/>
                <Button fx:id="btnHelp" text="⚙   Trợ giúp" styleClass="menu-btn, menu-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT"/>

                <!-- ADMIN -->
                <Button fx:id="btnAdminAccount" text="👤   Tài khoản" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToAdminAccount" visible="false" managed="false"/>
                <Button fx:id="btnDashboard" text="🛡   Dashboard" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToDashboard" visible="false" managed="false"/>
                <Button fx:id="btnApprove" text="📋   Duyệt sản phẩm" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToApprove" visible="false" managed="false"/>
                <Button fx:id="btnUsers" text="👥   Quản lý người dùng" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToUsers" visible="false" managed="false"/>
                <Button fx:id="btnAdminHelp" text="⚙   Trợ giúp" styleClass="menu-btn, menu-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT" visible="false" managed="false"/>

            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-profile">
                <StackPane>
                    <Circle radius="18" fill="#5A6C8A"/>
                    <Label fx:id="lblSidebarAvatar" text="NV" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblSidebarName" text="User" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label fx:id="lblSidebarRole" text="Thành viên" style="-fx-text-fill: #A0ABC0; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="20">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>
            <Label text="Trợ giúp" styleClass="page-title"/>
            <Label text="Hướng dẫn sử dụng hệ thống đấu giá" styleClass="page-subtitle"/>
            <VBox styleClass="card" spacing="15">
                <Label text="📖 HƯỚNG DẪN SỬ DỤNG" styleClass="section-title"/>
                <Label styleClass="card-subtitle" wrapText="true">• Truy cập Sàn đấu giá, chọn sản phẩm và nhập giá mong muốn.</Label>
                <Label styleClass="card-subtitle" wrapText="true">• Theo dõi phiên đấu giá đang tham gia tại "Bid đang tham gia".</Label>
                <Label styleClass="card-subtitle" wrapText="true">• Quản lý thông tin tài khoản tại "Tài khoản" (đổi mật khẩu, email).</Label>
            </VBox>
            <VBox styleClass="card" spacing="15">
                <Label text="📞 LIÊN HỆ" styleClass="section-title"/>
                <Label styleClass="card-subtitle" wrapText="true">Nhóm 3HxD - Trường Đại học Công nghệ, ĐHQGHN.</Label>
            </VBox>
        </VBox>
    </center>
</BorderPane>