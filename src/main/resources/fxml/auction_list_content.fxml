<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="main-content" spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.AuctionListContentController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Trang chủ" styleClass="breadcrumb-link"/>
        <Label text="/" styleClass="breadcrumb-text"/>
        <Label text="Sàn đấu giá" styleClass="breadcrumb-text"/>
    </HBox>

    <Label text="Sàn đấu giá trực tuyến" styleClass="page-title"/>
    <Label text="Khám phá và tham gia các phiên đấu giá đang diễn ra" styleClass="page-subtitle"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="Tìm kiếm sản phẩm..." styleClass="input-field" HBox.hgrow="ALWAYS"/>
        <Button text="🔍 Tìm" styleClass="action-btn-primary" onAction="#handleSearch"/>
        <Button fx:id="btnFilter" text="Bộ lọc" styleClass="action-btn-secondary" onAction="#handleFilter"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="auctionContainer" hgap="20" vgap="20" style="-fx-padding: 10;"/>
    </ScrollPane>
</VBox>