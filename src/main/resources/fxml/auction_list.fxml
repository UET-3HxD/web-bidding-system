<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.AuctionListController" style="-fx-background-color: #f0f2f5;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <children>
        <Label text="DANH SÁCH PHIÊN ĐẤU GIÁ" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <TableView fx:id="auctionTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="productNameColumn" text="Tên sản phẩm" prefWidth="200"/>
                <TableColumn fx:id="currentPriceColumn" text="Giá hiện tại (VNĐ)" prefWidth="150"/>
                <TableColumn fx:id="endTimeColumn" text="Thời gian kết thúc" prefWidth="200"/>
                <TableColumn fx:id="sellerColumn" text="Người bán" prefWidth="150"/>
            </columns>
        </TableView>

        <!-- Thông báo và loading -->
        <HBox alignment="CENTER" spacing="10">
            <children>
                <Label fx:id="messageLabel" text="" style="-fx-text-fill: red;" visible="false"/>
                <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="30" prefHeight="30"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button fx:id="refreshButton" text="Làm mới" onAction="#handleRefresh"/>
                <Button fx:id="detailButton" text="Xem chi tiết" onAction="#handleViewDetail"/>
            </children>
        </HBox>
    </children>
</VBox>
