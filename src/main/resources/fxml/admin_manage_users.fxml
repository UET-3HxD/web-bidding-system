<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.AdminManageUsersController">

    <!-- ================= SIDEBAR ADMIN ================= -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="30" left="10"/></padding>
                <Label text="⚖" styleClass="logo-icon"/>
                <Label text="3HxD Admin" styleClass="logo-text"/>
            </HBox>
            <VBox spacing="5">
                <Button fx:id="btnAccount" text="👤   Tài khoản" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToAccount"/>
                <Button fx:id="btnDashboard" text="🛡   Dashboard" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToDashboard"/>
                <Button fx:id="btnApprove" text="📋   Duyệt sản phẩm" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToApprove"/>
                <Button fx:id="btnUsers" text="👥   Quản lý người dùng" styleClass="menu-btn, menu-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button fx:id="btnHelp" text="⚙   Trợ giúp" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToHelp"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-profile">
                <StackPane>
                    <Circle radius="18" fill="#5A6C8A"/>
                    <Label fx:id="lblSidebarAvatar" text="AD" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblSidebarName" text="Admin" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Quản trị viên" style="-fx-text-fill: #A0ABC0; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <!-- ================= NỘI DUNG CHÍNH ================= -->
    <center>
        <VBox styleClass="main-content" spacing="20">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <Label text="Quản lý người dùng" styleClass="page-title"/>
            <Label text="Xem và quản lý tài khoản người dùng trên hệ thống" styleClass="page-subtitle"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblUserCount" text="0 người dùng" styleClass="card-subtitle"/>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background: #222222; -fx-border-color: #222222;" VBox.vgrow="ALWAYS">
                <VBox fx:id="vboxUserList" spacing="15">
                    <Label text="Đang tải dữ liệu từ máy chủ..." styleClass="card-subtitle"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>