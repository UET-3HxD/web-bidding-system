<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.BidRoomController">

    <!-- ================= SIDEBAR TRÁI ================= -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="30" left="10"/></padding>
                <Label text="⚖" styleClass="logo-icon"/>
                <Label text="3HxD" styleClass="logo-text"/>
            </HBox>
            <VBox spacing="5">
                <Button text="👤   Tài khoản" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToAccount"/>
                <Button text="⏹   Sàn đấu giá" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleExitRoom"/>
                <Button text="⏱   Bid đang tham gia" styleClass="menu-btn, menu-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToMyBids"/>
                <Button text="📦   Sản phẩm của bạn" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToProducts"/>
                <Button text="⚙   Trợ giúp" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToHelp"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-profile">
                <StackPane>
                    <Circle radius="18" fill="#5A6C8A"/>
                    <Label fx:id="lblSidebarAvatar" text="NV" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblSidebarName" text="User" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Thành viên" style="-fx-text-fill: #A0ABC0; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <!-- ================= NỘI DUNG CHÍNH ================= -->
    <center>
        <VBox styleClass="main-content" spacing="20">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Sàn đấu giá" styleClass="breadcrumb-link" onMouseClicked="#handleExitRoom"/>
                <Label text=">" styleClass="breadcrumb-text"/>
                <Label fx:id="lblBreadcrumbName" text="Tên sản phẩm..." styleClass="breadcrumb-text"/>
            </HBox>

            <HBox spacing="30" VBox.vgrow="ALWAYS">

                <!-- Cột trái: Ảnh + thông tin sản phẩm -->
                <VBox spacing="15" HBox.hgrow="ALWAYS" prefWidth="550">
                    <Label fx:id="lblProductName" text="Đang tải tên sản phẩm..." styleClass="page-title"/>

                    <StackPane styleClass="card" minHeight="350" VBox.vgrow="ALWAYS">
                        <ImageView fx:id="imgProductLarge" fitWidth="500" fitHeight="350" preserveRatio="true" visible="false"/>
                        <VBox fx:id="vboxNoImage" alignment="CENTER" spacing="10">
                            <Label text="📷" style="-fx-font-size: 60px; -fx-text-fill: #6B7280;"/>
                            <Label text="Đang tải ảnh sản phẩm..." styleClass="card-subtitle"/>
                        </VBox>
                    </StackPane>

                    <VBox spacing="12" styleClass="card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox spacing="10">
                            <Label text="Người bán:" styleClass="input-label" minWidth="120"/>
                            <Label fx:id="lblSeller" text="---" styleClass="card-subtitle"/>
                        </HBox>
                        <HBox spacing="10">
                            <Label text="Loại sản phẩm:" styleClass="input-label" minWidth="120"/>
                            <Label fx:id="lblCategory" text="---" styleClass="card-subtitle"/>
                        </HBox>
                        <VBox spacing="8">
                            <Label text="Mô tả sản phẩm:" styleClass="input-label"/>
                            <Label fx:id="lblDescription" text="Đang tải mô tả..." wrapText="true" styleClass="card-subtitle" minHeight="100" alignment="TOP_LEFT"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- Cột phải: Đấu giá -->
                <VBox spacing="20" prefWidth="380" minWidth="380">

                    <HBox alignment="CENTER_RIGHT">
                        <Button text="✖ Đóng phòng" styleClass="action-btn-secondary" onAction="#handleExitRoom"/>
                    </HBox>

                    <VBox spacing="10" styleClass="card" minHeight="200">
                        <Label text="DIỄN BIẾN GIÁ" styleClass="section-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <Label text="Biểu đồ đang được phát triển..." styleClass="card-subtitle"/>
                        </StackPane>
                    </VBox>

                    <VBox spacing="15" styleClass="card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <HBox spacing="20">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Thời gian còn lại" styleClass="input-label"/>
                                <Label fx:id="lblTimeLeft" text="--:--:--" style="-fx-font-size: 28px; -fx-text-fill: #F59E0B; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox alignment="TOP_RIGHT">
                                <Label text="Bước nhảy tối thiểu" styleClass="input-label"/>
                                <Label fx:id="lblMinIncrement" text="0 VNĐ" styleClass="card-subtitle"/>
                            </VBox>
                        </HBox>
                        <Separator styleClass="divider"/>
                        <VBox spacing="10">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Giá cao nhất hiện tại" styleClass="input-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblHighestBid" text="0 VNĐ" style="-fx-font-size: 22px; -fx-text-fill: #10B981; -fx-font-weight: bold;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Giá gần nhất của bạn" styleClass="input-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblYourLastBid" text="---" style="-fx-font-size: 22px; -fx-text-fill: #F43F5E; -fx-font-weight: bold;"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="12" styleClass="card">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                        <Label text="ĐẶT GIÁ CỦA BẠN" styleClass="section-title"/>
                        <TextField fx:id="txtBidInput" promptText="Nhập số tiền (VNĐ)..." styleClass="input-field"/>
                        <HBox spacing="12">
                            <Button text="Tự động" styleClass="action-btn-secondary" prefWidth="120"/>
                            <Button fx:id="btnPlaceBid" text="ĐẶT GIÁ NGAY" styleClass="action-btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handlePlaceBid"/>
                        </HBox>
                        <Label text="* Giá đặt phải lớn hơn Giá hiện tại + Bước giá" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>