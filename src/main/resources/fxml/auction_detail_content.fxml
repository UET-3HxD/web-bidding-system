<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="main-content" spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.AuctionDetailContentController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Quay lại danh sách" styleClass="action-btn-secondary" onAction="#handleGoBack"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Label text="Trang chủ" styleClass="breadcrumb-link" onMouseClicked="#handleGoHome"/>
            <Label text="/" styleClass="breadcrumb-text"/>
            <Label text="Sàn đấu giá" styleClass="breadcrumb-link" onMouseClicked="#handleGoAuction"/>
            <Label text="/" styleClass="breadcrumb-text"/>
            <Label fx:id="lblItemName" text="Tên sản phẩm" styleClass="breadcrumb-text"/>
        </HBox>
    </HBox>

    <HBox spacing="30" alignment="TOP_LEFT">
        <StackPane styleClass="auction-image" minWidth="300" minHeight="300">
            <Label text="🖼" styleClass="auction-image-placeholder"/>
        </StackPane>
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitle" text="iPhone 15 Pro Max" styleClass="page-title"/>
            <Label fx:id="lblStatus" styleClass="status-badge, status-badge-active" text="Đang đấu giá"/>
            <VBox spacing="5">
                <Label text="Giá hiện tại" styleClass="input-label"/>
                <Label fx:id="lblCurrentPrice" text="12.500.000 ₫" style="-fx-font-size: 24px; -fx-text-fill: #10B981; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Thời gian còn lại" styleClass="input-label"/>
                <Label fx:id="lblTimeLeft" text="⏳ 2 giờ 15 phút" styleClass="auction-time"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Giá khởi điểm" styleClass="input-label"/>
                <Label text="10.000.000 ₫" styleClass="card-subtitle"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Mô tả sản phẩm" styleClass="input-label"/>
                <Label text="Sản phẩm mới 99%, còn bảo hành..." styleClass="card-subtitle" wrapText="true"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBidAmount" promptText="Nhập giá muốn trả" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                <Button text="Đặt giá ngay" styleClass="bid-now-btn" onAction="#handlePlaceBid"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>