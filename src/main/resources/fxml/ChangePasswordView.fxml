<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.ChangePasswordController">

    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="30" left="10"/></padding>
                <Label text="⚖" styleClass="logo-icon"/>
                <Label text="BidVN" styleClass="logo-text"/>
            </HBox>

            <VBox spacing="5">
                <Button text="👤   Tài khoản" styleClass="menu-btn, menu-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="⏹   Sàn đấu giá" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="⏱   Bid đang tham gia" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="📦   Sản phẩm của bạn" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="⚙   Trợ giúp" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-profile">
                <StackPane>
                    <Circle radius="18" fill="#5A6C8A"/>
                    <Label fx:id="lblSidebarAvatar" text="NV" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblSidebarName" text="User" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Thành viên" style="-fx-text-fill: #A0ABC0; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="25">
            <padding>
                <Insets top="40" right="150" bottom="40" left="60"/>
            </padding>

            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label onMouseClicked="#handleBackToAccount" styleClass="breadcrumb-link" text="Tài khoản" />
                <Label styleClass="breadcrumb-text" text="  &gt;  Đổi mật khẩu" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label styleClass="icon-large-container" text="🔒" />
                <VBox spacing="2">
                    <Label styleClass="page-title" text="Đổi mật khẩu" />
                    <Label styleClass="page-subtitle" text="Nhập mật khẩu hiện tại và mật khẩu mới để cập nhật" />
                </VBox>
            </HBox>

            <VBox spacing="20">
                <VBox spacing="8">
                    <Label styleClass="input-label" text="Mật khẩu cũ" />
                    <PasswordField fx:id="txtOldPass" promptText="Nhập mật khẩu hiện tại" styleClass="input-field" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="input-label" text="Mật khẩu mới" />
                    <PasswordField fx:id="txtNewPass" promptText="Ít nhất 8 ký tự" styleClass="input-field" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="input-label" text="Nhập lại mật khẩu mới" />
                    <PasswordField fx:id="txtConfirmPass" promptText="Nhập lại mật khẩu mới" styleClass="input-field" />
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button onAction="#handleSavePassword" prefWidth="300" styleClass="action-btn-primary" text="Lưu mật khẩu" />
                <Button onAction="#handleCancel" prefWidth="100" styleClass="action-btn-secondary" text="Huỷ" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
