<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.team3HxD.controller.LoginController"
            stylesheets="@../styles/login.css"
            styleClass="login-root">

   <HBox AnchorPane.topAnchor="0"
         AnchorPane.bottomAnchor="0"
         AnchorPane.leftAnchor="0"
         AnchorPane.rightAnchor="0">

      <!-- LEFT PANEL -->
      <VBox prefWidth="420"
            styleClass="left-panel">

         <padding>
            <Insets top="45" right="45" bottom="45" left="45"/>
         </padding>

         <!-- Logo -->
         <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="⚖" styleClass="logo-icon"/>
            <Label text="3HxD" styleClass="logo-text"/>
         </HBox>

         <Region VBox.vgrow="ALWAYS"/>

         <!-- Welcome -->
         <VBox spacing="22">
            <Label text="Welcome to&#10;3HxD!"
                   wrapText="true"
                   styleClass="welcome-title"/>

            <Label text="Đăng nhập để tham gia sàn đấu giá sôi động nhất thế giới."
                   wrapText="true"
                   maxWidth="280"
                   styleClass="welcome-description"/>
         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

      </VBox>

      <!-- RIGHT PANEL -->
      <StackPane HBox.hgrow="ALWAYS"
                 styleClass="right-panel">

         <VBox alignment="CENTER"
               spacing="28"
               prefWidth="520"
               maxWidth="520"
               styleClass="login-card">

            <padding>
               <Insets top="50" right="45" bottom="45" left="45"/>
            </padding>

            <!-- HEADER -->
            <VBox alignment="CENTER" spacing="10">
               <Label text="ĐĂNG NHẬP"
                      styleClass="login-title"/>

               <Label text="THÔNG TIN HỆ THỐNG"
                      styleClass="login-subtitle"/>
            </VBox>

            <!-- INPUTS -->
            <VBox spacing="18">

               <TextField fx:id="usernameField"
                          promptText="Tên đăng nhập"
                          styleClass="modern-input"/>

               <PasswordField fx:id="passwordField"
                              promptText="Mật khẩu"
                              styleClass="modern-input"/>
            </VBox>

            <!-- LOGIN BUTTON -->
            <Button fx:id="loginButton"
                    text="ĐĂNG NHẬP   →"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    styleClass="login-button"/>

            <!-- OR -->
            <HBox alignment="CENTER"
                  spacing="12">

               <Separator prefWidth="120"
                          styleClass="separator-modern"/>

               <Label text="HOẶC"
                      styleClass="or-text"/>

               <Separator prefWidth="120"
                          styleClass="separator-modern"/>
            </HBox>

            <!-- REGISTER -->
            <Button fx:id="registerButton"
                    text="👤  Bạn chưa có tài khoản? Đăng ký ngay"
                    onAction="#handleRegister"
                    maxWidth="Infinity"
                    styleClass="register-button"/>

            <!-- MESSAGE -->
            <StackPane>

               <ProgressIndicator fx:id="loadingIndicator"
                                  visible="false"
                                  maxHeight="26"/>

               <Label fx:id="messageLabel"
                      visible="false"
                      styleClass="message-label"/>
            </StackPane>

         </VBox>

      </StackPane>

   </HBox>

</AnchorPane>