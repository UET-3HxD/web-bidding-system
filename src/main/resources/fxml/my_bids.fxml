<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.team3HxD.controller.MyBidsController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="30" left="10"/></padding>
                <Label text="⚖" styleClass="logo-icon"/>
                <Label text="3HxD" styleClass="logo-text"/>
            </HBox>
            <VBox spacing="5">
                <Button fx:id="btnAccount" text="👤   Tài khoản" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToAccount"/>
                <Button fx:id="btnAuction" text="⏹   Sàn đấu giá" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToAuction"/>
                <Button fx:id="btnBids" text="⏱   Bid đang tham gia" styleClass="menu-btn, menu-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button fx:id="btnProducts" text="📦   Sản phẩm của bạn" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToProducts"/>
                <Button fx:id="btnHelp" text="⚙   Trợ giúp" styleClass="menu-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleGoToHelp"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-profile">
                <StackPane>
                    <Circle radius="18" fill="#5A6C8A"/>
                    <Label fx:id="lblSidebarAvatar" text="NV" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblSidebarName" text="User" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Thành viên" style="-fx-text-fill: #A0ABC0; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <!-- ================= NỘI DUNG CHÍNH (2 cột bằng nhau) ================= -->
    <center>
        <StackPane style="-fx-background-color: #0a0a0a;">
            <HBox spacing="20" style="-fx-padding: 20;" HBox.hgrow="ALWAYS">
                <!-- ================= CỘT TRÁI: DANH SÁCH ================= -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <VBox>
                        <Label text="Bid đang tham gia" styleClass="page-title"/>
                        <Label text="Các phiên đấu giá bạn đã và đang tham gia" styleClass="page-subtitle"/>
                    </VBox>

                    <HBox spacing="10">
                        <ComboBox fx:id="cbStatusFilter" promptText="Tất cả trạng thái" styleClass="input-field" prefWidth="180"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background: #0a0a0a; -fx-border-color: #2A2A2A;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="vboxBidList" spacing="10">
                            <Label text="Đang tải dữ liệu từ máy chủ..." styleClass="card-subtitle"/>
                        </VBox>
                    </ScrollPane>
                </VBox>

                <!-- ================= CỘT PHẢI: CHI TIẾT ================= -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <StackPane style="-fx-background-color: #1a1a1a; -fx-background-radius: 8;" prefHeight="220">
                        <VBox alignment="CENTER" spacing="10">
                            <Label text="📷" style="-fx-font-size: 40px; -fx-text-fill: #64748B;"/>
                            <Label text="Ảnh sản phẩm" styleClass="card-subtitle"/>
                        </VBox>
                        <ImageView fx:id="imgDetailImage" fitWidth="200" fitHeight="200" preserveRatio="true" visible="false"/>
                    </StackPane>

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label fx:id="lblDetailName" text="Tên sản phẩm" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDetailStatus" text="Trạng thái" styleClass="badge"/>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Danh mục" styleClass="input-label"/>
                        <Label fx:id="lblDetailCategory" text="---" styleClass="card-subtitle"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Giá khởi điểm" styleClass="input-label"/>
                        <Label fx:id="lblDetailStartPrice" text="---" styleClass="card-subtitle"/>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox>
                            <Label text="Giá hiện tại" styleClass="input-label"/>
                            <Label fx:id="lblDetailCurrentPrice" text="0 đ" style="-fx-font-size: 24px; -fx-text-fill: #10B981; -fx-font-weight: bold;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT">
                            <Label text="Giá của bạn" styleClass="input-label"/>
                            <Label fx:id="lblDetailYourBid" text="---" style="-fx-font-size: 18px; -fx-text-fill: #F59E0B; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <Button fx:id="btnEnterRoom" text="🔨 Vào phòng đấu giá" styleClass="action-btn-primary" maxWidth="Infinity" visible="false" onAction="#handleEnterBidRoom"/>
                </VBox>
            </HBox>
        </StackPane>
    </center>
</BorderPane>